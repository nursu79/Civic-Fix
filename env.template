# CivicFix Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# APP
# ============================================
# Your production domain — used for CORS origin restriction on API routes
# DO NOT use a wildcard. Must match your exact deployment URL.
NEXT_PUBLIC_APP_URL=https://civicfix.et

# ============================================
# SUPABASE
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# ⚠️  WARNING: NEVER commit the service role key to git!
# It bypasses ALL Row Level Security. Only use server-side if absolutely required.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# MAPBOX
# ============================================
# Get from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# ============================================
# AFRICA'S TALKING (SMS)
# ============================================
# Get from: https://account.africastalking.com/apps/sandbox/settings
AFRICAS_TALKING_API_KEY=your_api_key
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=CivicFix
